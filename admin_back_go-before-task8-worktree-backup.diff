+		RunID:       input.RunID,
+		Seq:         input.Seq,
+		EventID:     input.EventID,
+		EventType:   input.EventType,
+		DeltaText:   input.DeltaText,
+		PayloadJSON: payload,
+		CreatedAt:   createdAt,
+	}).Error
+}
