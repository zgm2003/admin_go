+func (r *GormRepository) upsertUsageDaily(tx *gorm.DB, runID int64, failed bool) error {
+	var run Run
+	if err := tx.Where("id = ?", runID).First(&run).Error; err != nil {
+		return err
+	}
+	day := time.Now()
+	if run.CompletedAt != nil {
+		day = *run.CompletedAt
+	} else if !run.CreatedAt.IsZero() {
