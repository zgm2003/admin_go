-func normalizeJSON(value string) map[string]any {
-	value = strings.TrimSpace(value)
-	if value == "" {
-		return map[string]any{}
-	}
-	var parsed map[string]any
-	if err := json.Unmarshal([]byte(value), &parsed); err != nil || parsed == nil {
-		return map[string]any{}
-	}
-	return parsed
-}
