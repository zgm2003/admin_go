-
-	if name == "" {
-		return normalizedFields{}, apperror.BadRequest("渠道名称不能为空")
-	}
-	if len([]rune(name)) > 50 {
-		return normalizedFields{}, apperror.BadRequest("渠道名称不能超过50个字符")
-	}
-	if !enum.IsPayChannel(channel) {
-		return normalizedFields{}, apperror.BadRequest("无效的支付渠道")
