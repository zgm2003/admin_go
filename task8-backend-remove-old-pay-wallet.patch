-func truncateRuntimeError(err error, maxRunes int) string {
-	if err == nil {
-		return ""
-	}
-	if maxRunes <= 0 {
-		maxRunes = 500
-	}
-	message := strings.TrimSpace(err.Error())
-	runes := []rune(message)
-	if len(runes) <= maxRunes {
-		return message
-	}
-	return string(runes[:maxRunes])
-}
