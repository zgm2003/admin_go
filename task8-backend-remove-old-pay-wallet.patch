-	}
-	if err := json.Unmarshal(payload, &row); err != nil {
-		return FulfillmentRetryPayload{}, fmt.Errorf("decode %s payload: %w", TypeFulfillmentRetryV1, err)
-	}
-	return row, nil
-}
