-func nextFulfillmentRetryAt(now time.Time, currentRetryCount int) time.Time {
-	if currentRetryCount < 0 {
-		currentRetryCount = 0
-	}
-	delay := fulfillmentRetryBaseDelay
-	for i := 0; i < currentRetryCount; i++ {
-		delay *= 2
-	}
-	return now.Add(delay)
-}
